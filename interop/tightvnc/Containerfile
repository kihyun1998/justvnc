FROM ubuntu:24.04
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tightvncserver x11-apps xfonts-base \
 && rm -rf /var/lib/apt/lists/*
COPY start.sh /start.sh
EXPOSE 5900
# Xtightvnc 1.3.10: the one server here whose Tight encoder uses the gradient filter.
# GEOMETRY: screen size (default 800x600). No password: security type None.
# x11-apps provides xwud, to show recorded test images.
CMD ["sh", "/start.sh"]
